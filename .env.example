# Primer promenljivih okruženja. Kopiraj u .env.local i popuni stvarne vrednosti.
# Ovaj fajl se komituje u git, .env.local nikad.

# Konekcija na lokalnu PostgreSQL bazu (razvoj).
DATABASE_URL="postgresql://localhost:5432/aik_dev"

# Naziv usluge je konfiguracija, ne hardkodovan string (spec 1.5: "Tvoj AI knjigovođa" / "Fakturica").
NEXT_PUBLIC_APP_NAME="Tvoj AI knjigovođa"
