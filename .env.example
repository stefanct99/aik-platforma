# Primer promenljivih okruženja. Kopiraj u .env.local i popuni stvarne vrednosti.
# Ovaj fajl se komituje u git, .env.local nikad.

DATABASE_URL=
# Posebna baza za automatske testove (vitest), ime MORA da se završava na _test, nikad aik_dev.
DATABASE_URL_TEST=
NEXT_PUBLIC_APP_NAME=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
INBOUND_MAIL_DOMAIN=
# Google prijava (Korak 5): opciono. Dok su prazni, dugme "Nastavi sa Google nalogom" je vidljivo ali
# onemogućeno (vidi src/lib/google-prijava.ts). Popuni oba da bi dugme proradilo, ništa drugo u kodu ne
# treba da se menja.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
