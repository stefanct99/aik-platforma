datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

model User {
  id                   String                @id
  name                 String
  email                String
  emailVerified        Boolean               @default(false)
  image                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  role                 String?               @default("user")
  // Izgled (Korak 4b, spec 7.13): "svetli", "tamni" ili "sistem" (prati podešavanje uređaja). Lično
  // podešavanje korisnika, ne firme, zato je ovde, ne na Business.
  theme                String                @default("sistem")
  // Jezik i format datuma (Korak 7, Pd7): "sr-lat"/"sr-cir"/"en" i "dmy"/"iso". Jezik se čuva ali NE
  // prevodi interfejs u ovom koraku (nema prevoda teksta - vidi izveštaj). Format datuma se STVARNO
  // primenjuje svuda preko formatDatum() u src/lib/datum.ts.
  jezik                String                @default("sr-lat")
  formatDatuma         String                @default("dmy")
  sessions             Session[]
  accounts             Account[]
  businesses           Business[]
  notificationSettings NotificationSettings?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

// Korak 5, spec 7.1: zaključavanje naloga posle 5 uzastopnih neuspešnih pokušaja prijave, na 15 minuta.
// Čuva se po e-mailu (ne po IP adresi, ne po postojećem korisniku), zato je ovo poseban model, nezavisan
// od User: pokušaj prijave na e-mail koji i ne postoji mora isto da se broji, da se ne otkrije (kroz
// razliku u ponašanju) da li nalog postoji.
model LoginAttempt {
  email       String    @id
  failedCount Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@map("login_attempt")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Spec 3.1. Model NAMERNO ne ograničava ownerId na @unique: v1 dozvoljava samo jednu firmu po
// korisniku, ali to je pravilo APLIKACIJE (vidi src/lib/business.ts), ne šeme, da višestruke firme
// kasnije ne traže migraciju. PIB je jedinstven u celoj bazi (spec 3.1).
model Business {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name             String
  ownerName        String
  pib              String   @unique
  mb               String
  // Šifra je iz Klasifikacije delatnosti 2025 (KD 2025, Uredba "Sl. glasnik RS" br. 91/2026), oblik
  // sa tačkom (npr. "62.10"), ne 4 cifre bez tačke kako spec 3.1 kaže (spec je pisana pre KD 2025,
  // vidi izveštaj Koraka 2b). delatnostVerzija postoji da promena klasifikacije kasnije ne zahteva
  // pogađanje kog je oblika stara šifra.
  delatnostCode    String
  delatnostName    String
  delatnostVerzija String   @default("KD2025")
  regDate          DateTime

  street       String?
  city         String?
  zip          String?
  contactEmail String?
  phone        String?
  logoUrl      String?

  // Adresa za prijem mejlova banke (spec 3.1): "<slug>-<kod>@<domen>". Domen je env konstanta
  // (još ne postoji, vidi src/lib/inbound-mail.ts), ovde se čuvaju samo slug i kod.
  inboundSlug String
  inboundCode String

  // Status onboardinga: koji je korak (1-4) sledeći za prikaz, i kad je završen.
  onboardingStep        Int       @default(1)
  onboardingCompletedAt DateTime?

  // Rešenje Poreske uprave ne postoji još (budući korak), ovo je samo podrazumevana vrednost.
  taxDecisionStatus String @default("nije_dodato")

  // Korak 7, spec 7.13 (Povezivanje): privatan token za pretplatu na kalendar (tvojaiknjigovodja.rs/cal/
  // <token>). Nasumičan, menja se na zahtev korisnika ("Generiši novi") - stari odmah prestaje da važi,
  // zato NIJE isti kao inboundCode (taj se ne menja). calendarSyncEnabled je prekidač iz frejma Pd5 -
  // za sada bez stvarnog efekta na ICS fajl (nema događaja koje bi uključivao/isključivao), samo se čuva.
  calendarToken       String  @unique
  calendarSyncEnabled Boolean @default(true)

  bankAccounts      BankAccount[]
  clients           Client[]
  invoices          Invoice[]
  incomes           Income[]
  recurringInvoices RecurringInvoice[]
  invoiceTemplates  InvoiceTemplate[]
  taxDecisions      TaxDecision[]
  taxPayments       TaxPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inboundSlug, inboundCode])
  @@index([ownerId])
  @@map("business")
}

// Korak 7, spec 7.13 (Računi): dinarski ili devizni račun firme. "Samo jedan podrazumevani po valuti" je
// pravilo APLIKACIJE (src/lib/bank-accounts.ts), ne šeme - isti pristup kao "jedna firma po korisniku"
// na Business (vidi komentar tamo), da kasnija izmena pravila ne traži migraciju.
model BankAccount {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  type     String // "RSD" ili "devizni"
  currency String // "RSD", "EUR", "USD", "GBP", "CHF"...
  bank     String

  // Dinarski (type="RSD") koristi number, devizni (type="devizni") koristi iban i swift - nikad oba.
  number String?
  iban   String?
  swift  String?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Korak 8a: InvoiceDraftStub (privremeni zamenik iz Koraka 7, samo za proveru "račun u upotrebi") je
  // zamenjen pravim Invoice/Client modelima ispod - ista provera (removeAccount u src/lib/bank-
  // accounts.ts), sad nad stvarnim podacima.
  invoices          Invoice[]
  defaultForClients Client[]

  @@index([businessId])
  @@map("bank_account")
}

// Korak 7, spec 7.13 (Obaveštenja): po jedan red po korisniku, Mejl/Push prekidač za svaku od šest vrsta
// iz frejma Pd4. Podrazumevane vrednosti su tačno one iz frejma (sve uključeno osim AI/propisi push i
// nedeljni pregled oba kanala).
model NotificationSettings {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  rokoviMail   Boolean @default(true)
  rokoviPush   Boolean @default(true)
  kasneMail    Boolean @default(true)
  kasnePush    Boolean @default(true)
  mejlMail     Boolean @default(true)
  mejlPush     Boolean @default(true)
  primetioMail Boolean @default(true)
  primetioPush Boolean @default(false)
  propisiMail  Boolean @default(true)
  propisiPush  Boolean @default(false)
  nedeljniMail Boolean @default(false)
  nedeljniPush Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@map("notification_settings")
}

// Klijent (Korak 8a, spec 3.3, 7.6). "Tip (domaći dinarski ili inostrani)" iz specifikacije je IZVEDENO
// iz defaultCurrency==="RSD" (src/lib/clients.ts), ne posebno polje - isto načelo kao Kasni kod fakture.
model Client {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Obavezno (odluka vlasnika, Korak 8b ispravka, 2026-11-25 - PREGAZI spec 3.3 i prototip, koji su
  // tražili i mejl): naziv i adresa. Sve ostalo (mejl, PIB, zemlja...) je opciono - prazno polje nikad
  // ne sme da blokira čuvanje klijenta ni slanje fakture (videti src/lib/clients.ts).
  name         String
  country      String?
  billingEmail String?
  pib          String?
  address      String

  defaultCurrency  String       @default("EUR")
  defaultLang      String       @default("sr") // "sr" ili "en"
  defaultDueDays   Int          @default(7)
  defaultAccountId String?
  defaultAccount   BankAccount? @relation(fields: [defaultAccountId], references: [id], onDelete: SetNull)

  // Podrazumevana stavka (nije obavezno, spec 3.3): null = "Iznos se upisuje na fakturi".
  defaultItemDesc   String?
  defaultItemAmount Int?

  // Mejlovi banke za ovog klijenta (Korak 8a, tačka 5): SAMO polja koja se čuvaju, bez ikakvog dejstva
  // dok ne gradimo tab Mejlovi banke. "nasledi" = "Kao u opštim podešavanjima" (frejm Fak28).
  autoSendMode String @default("nasledi") // "nasledi" | "ask" | "auto"
  fxMode       String @default("proknjizi") // "proknjizi" | "prodaj_deo" | "prodaj_sve"

  // "Klijent bez faktura može da se obriše" (spec 3.3) - inače se arhivira (src/lib/clients.ts).
  archived Boolean @default(false)

  invoices          Invoice[]
  recurringInvoices RecurringInvoice[]
  incomes           Income[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@map("client")
}

// Ponavljajuća faktura (Korak 8c, spec 3.5/6.8, frejmovi Fak13/Fak14). "Stavka (opis, iznos, može da
// bude prazna)" (spec 3.5, frejm Fak13 treći red "Marko Petrović PR" - klijent bez podrazumevane cene
// nema stavku UOPŠTE prikazanu, ne samo iznos) - desc i amount su oba nullable. Valuta NIJE sopstveno
// polje (ni spec 3.5 ni frejm Fak14 je ne pominju, ni prototip RecurringPanel je ne pita) - uvek se
// uzima iz client.defaultCurrency u trenutku prikaza/generisanja, isto za rok i račun (src/lib/
// recurring-invoices.ts). mode koristi ISTE vrednosti kao Client.autoSendMode ("ask"/"auto") iz istog
// razloga (već postojeća konvencija u šemi), ne nove nazive.
model RecurringInvoice {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  clientId String
  // Restrict, isto kao Invoice.client - klijent sa aktivnom ponavljajućom fakturom ne sme da se obriše
  // direktno (src/lib/clients.ts imaFaktura/removeOrArchiveClient uključuje i ove).
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  desc   String?
  amount Int? // null = "Iznos se upisuje pri slanju" (spec 3.5, zadatak tačka 3: tad mode mora biti "ask")

  frequency  String    @default("mesecno") // samo "mesecno" postoji u ovoj verziji (spec 3.5)
  dayOfMonth Int // 1-31; ako mesec ima manje dana, koristi se poslednji dan tog meseca
  startDate  DateTime
  endDate    DateTime? // null = "Nikad"

  mode   String @default("ask") // "ask" | "auto"
  status String @default("aktivna") // "aktivna" | "pauzirana"

  nextDate DateTime // datum sledeće fakture (spec 3.5) - pomera ga generisanje (src/lib/recurring-invoices.ts)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([clientId])
  @@map("recurring_invoice")
}

// Brojač faktura po firmi i po godini IZDAVANJA (ne po "poslovnoj godini") - Korak 8a, pravilo numeracije
// odlučeno sa Stefanom (PREGAZI spec 8.2 i prototip): N/GG-M, brojač N se vraća na 1 svakog 1. januara.
// Composite primarni ključ JESTE jedinstveno ograničenje iz zadatka - atomski UPSERT (src/lib/invoices.ts)
// nad njim sprečava da dve istovremene fakture dobiju isti broj, bez potrebe za ručnim zaključavanjem.
model InvoiceCounter {
  businessId String
  year       Int
  lastNumber Int    @default(0)

  @@id([businessId, year])
  @@map("invoice_counter")
}

// Faktura (Korak 8a, spec 3.4). Status: "nacrt" | "poslata" | "placena" | "stornirana" - "kasni" je
// IZVEDENO (spec 8.1), nikad upisano (src/lib/invoice-status.ts, isti princip kao prototip).
model Invoice {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  clientId String
  // Restrict (ne Cascade): klijent sa fakturama ne sme da se obriše, samo arhivira (src/lib/clients.ts).
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  number String // format "N/GG-M", npr. "25/26-11" (videti src/lib/invoice-numbering.ts)

  currency String
  lang     String @default("sr") // "sr" ili "en" - menja fiksne nazive u dokumentu (spec 7.4)

  issueDate DateTime
  dueDays   Int
  note      String?

  accountId String?
  account   BankAccount? @relation(fields: [accountId], references: [id])

  status String @default("nacrt")

  sentAt           DateTime?
  paidDate         DateTime?
  voidedAt         DateTime?
  // Da li je kvačica "Obavesti klijenta mejlom" bila čekirana pri storniranju (Fak17) - istorijski zapis.
  voidNotifyClient Boolean?

  // Zamrznut izgled (Korak 8d-1, odluka 1): kopija podataka šablona (isti oblik kao InvoiceTemplate
  // ispod: blocks/blocksOff/layout/accentColor/blockProps/table/doc) u trenutku slanja. null za nacrte
  // (koji prate TRENUTNI šablon firme, bez kopije) i za fakture poslate pre ovog koraka (crtaju se iz
  // podrazumevanog šablona firme - vidi izveštaj). Popunjavanje ovog polja pri slanju dolazi u kasnijem
  // koraku (8d-2/8d-3, kad postoji funkcija koja bira pravi šablon za fakturu) - ovde postoji samo mesto.
  templateSnapshot Json?

  items   InvoiceItem[]
  events  InvoiceEvent[]
  incomes Income[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, number])
  @@index([businessId])
  @@index([clientId])
  @@map("invoice")
}

// Šablon izgleda fakture (Korak 8d-1, spec 7.6, frejmovi Fak18/Fak24-27). Oblik podataka je preuzet
// DIREKTNO iz prototipa (referenca/prototip/js/store.js, window.AIK.DEFAULT_TEMPLATE i
// invoiceTemplates), ne izmišljen ovde - isti nazivi polja (blocks/blocksOff/blockProps/table/doc/
// assignRule), da bi 8d-2 (crtanje) mogao da prepiše prototipovu logiku umesto da je ponovo smišlja.
// "Tačno jedan podrazumevani po firmi" je, kao i kod BankAccount.isDefault (vidi komentar tamo), pravilo
// APLIKACIJE (src/lib/invoice-templates.ts, osigurajPodrazumevaniSablon), ne šeme.
model InvoiceTemplate {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  isDefault   Boolean @default(false)
  layout      String  @default("klasican") // "klasican" | "moderan" | "minimalan" | "kompaktan"
  accentColor String  @default("#0F2A22")

  // Redosled blokova i koji su isključeni - oba String[] sa istim ključevima kao BLOCK_LABELS u
  // prototipu (logo/datum/broj/klijent/firma/banka/stavke/ukupno/rok/napomena/potpis).
  blocks    Json
  blocksOff Json

  // { [blokKljuc]: {x,y,w,h,align,size,color,font,bg,border} } - pozicija/stil svakog bloka na platnu.
  blockProps Json

  // Podešavanja tabele stavki (kolone, linije, razmak, boja zaglavlja) - vidi Fak25.
  table Json

  // Podešavanja cele fakture (fontovi, margine, traka, žig, podnožje, logo) - vidi Fak26.
  doc Json

  // null (bez pravila, uvek za podrazumevani) | {domestic:bool} | {currency:string} | {lang:"sr"|"en"}.
  assignRule Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@map("invoice_template")
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  desc  String
  qty   Int    @default(1)
  price Int // u najmanjoj jedinici valute fakture (para/cent), nikad float

  redosled Int @default(0)

  @@index([invoiceId])
  @@map("invoice_item")
}

// Istorija događaja fakture (spec 3.4): samo STVARNI, diskretni događaji. "Rok je istekao"/"Čeka uplatu"
// u pregledu fakture (7.5) se NE čita odavde - računa se uživo iz efektivnog statusa, isto kao "Kasni".
model InvoiceEvent {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  tip      String // "napravljena" | "poslata" | "placena" | "stornirana" | "podsetnik_poslat"
  datum    DateTime @default(now())
  napomena String?

  @@index([invoiceId])
  @@map("invoice_event")
}

// Uplata/Prihod (Korak 8a, spec 3.6) - nastaje ili preko "Označi kao plaćenu" (uvek sa invoiceId, izvor
// "rucno"), ili ručno preko "Dodaj prihod" (Korak 9d-1, invoiceId null, source "rucno", opciono
// clientId). Kurs i iznos u dinarima za devizne uplate ostaju prazni dok korisnik ne upiše kurs (Korak
// 9b/9c) - ne izmišlja se.
model Income {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  // Samo za ručne prihode BEZ fakture (Korak 9d-1, "Dodaj prihod") - kad invoiceId postoji, klijent se i
  // dalje čita preko fakture (invoice.client), ovo polje ostaje null (videti prihodi-db.ts). SetNull (ne
  // Restrict kao Invoice.client) - isti obrazac kao Client.defaultAccountId: klijent SME da se obriše dok
  // ovakav prihod ostaje u knjizi (samo mu "Klijent" postaje "Nije poznat", ne briše se prihod).
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  date     DateTime
  currency String
  amount   Int // u najmanjoj jedinici valute uplate

  // Samo za devizne (kind="devizni"). markInvoicePaid ga NE postavlja (frejmovi/prototip ne pokazuju unos
  // kursa u tom trenutku, videti izveštaj Korak 9b) - ostaje null dok kurs ne stigne nekim DRUGIM putem
  // (danas: samo probna dev skripta, scripts/popuni-probne-kurseve.ts). Prava NBS integracija (kurs na
  // dan priliva) je poseban, kasniji korak.
  rate      Float?
  amountRsd Int?

  source      String  @default("rucno") // "mejl_banke" | "rucno" (u 8a je uvek "rucno")
  kind        String // "devizni" | "dinarski"
  description String?

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([invoiceId])
  @@index([clientId])
  @@map("income")
}

// Rešenje Poreske uprave (Korak 10a, spec 3.9/6.2/8.7) - JEDNO po firmi i godinu (@@unique ispod), ne
// istorija verzija unutar iste godine: kad stigne novo rešenje za VEĆ postojeću godinu (retko - rešenja
// idu godišnje), aplikacija bi ga morala MENJATI (update), ne dodavati novi red (isto ponašanje kao
// prototip applyNewResenje, koji prepisuje postojeći taxDecision). Ručni unos (Korak 10b) i buduće
// čitanje fajla (Korak 10e) dele isti red - "source" razlikuje kako je nastao, isto polje/vrednosti kao
// Income.source ("rucno" | kasnije "procitano").
model TaxDecision {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  year Int

  // PIB PROČITAN SA REŠENJA (ne Business.pib) - upoređuje se sa Business.pib da bi se otkrila greška
  // "ovo rešenje nije za tvoju firmu" (frejm Rez5); null dok se ne upiše/pročita.
  pib String?

  // Null za ručni unos (Korak 10b, Rez6b nema fajl) - popunjava se tek kad postoji stvarno učitavanje
  // fajla (Korak 10e).
  fileName String?

  source String @default("rucno") // "rucno" (jedino danas) | kasnije "procitano"

  createdAt DateTime @default(now())

  obligations TaxObligation[]

  @@unique([businessId, year])
  @@index([businessId])
  @@map("tax_decision")
}

// Stavka rešenja (Korak 10a) - tačno četiri po rešenju u praksi (porez/pio/zdravstveno/nezaposlenost,
// spec 3.9), ali šema ne nameće broj četiri - to je pravilo APLIKACIJE (isti princip kao "jedan
// podrazumevani račun po valuti" na BankAccount, ne šema). racunPrimaoca/pozivNaBroj (racunPrimaoca =
// recipientAccount, pozivNaBroj = referenceNumber) su TEKSTUALNA polja koja korisnik prepisuje sa
// rešenja - ne računaju se (zadatak, spec 8.7 [PROVERITI] tačna šema).
model TaxObligation {
  id         String      @id @default(cuid())
  decisionId String
  decision   TaxDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  kind String // "porez" | "pio" | "zdravstveno" | "nezaposlenost"

  monthlyAmount Int // najmanja jedinica (para), isto kao Income.amount

  recipientAccount String?
  referenceNumber  String?

  payments TaxPayment[]

  @@unique([decisionId, kind])
  @@index([decisionId])
  @@map("tax_obligation")
}

// Uplata za jednu stavku, za jedan mesec USLUGE (Korak 10a, spec 3.9/6.3/8.7) - "mesec usluge" je mesec
// ZA KOJI se akontacija plaća (npr. akontacija za oktobar dospeva 15. novembra), ne mesec/datum same
// uplate (taj je u paidDate). businessId je namerno OVDE TAKOĐE (ne samo kroz obligation->decision->
// business) - direktan upit "sve uplate firme za mesec X" bez dva spoja, isti razlog kao Income.
// businessId pored invoiceId.
model TaxPayment {
  id           String        @id @default(cuid())
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  obligationId String
  obligation   TaxObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  year  Int
  month Int // 1-12

  status   String    @default("neplaceno") // "neplaceno" | "placeno"
  paidDate DateTime?
  method   String? // "qr" | "trajni_nalog" | "rucno"

  @@unique([obligationId, year, month])
  @@index([businessId, year, month])
  @@index([obligationId])
  @@map("tax_payment")
}
